# objbox 反向代理参考配置（nginx）
#
# 用途：把 objbox 的管理台接入 SSO（auth-gateway），同时**不影响 S3 协议**（AK/SK + SigV4）。
#
# 关键难点：S3 的 ListBuckets 就是 `GET /`，与浏览器打开管理台首页是同一个路径，
# 必须靠「请求有没有 SigV4 签名」来分流，不能无脑把 `/` 交给网关。
# 下面用两个 if 判 Authorization 头 / 查询串，最直观。
#
# 另两个踩过的坑（别再用 map 复刻）：
#   1) map 的 key 里写 `$arg_X-Amz-Signature` 是错的 —— nginx 变量名不含连字符，
#      它只会解析出 `$arg_X`，判定恒为空 → 分流永远走默认分支。
#   2) 不要把多个条件用 `|` 拼进一个正则 —— nginx 先处理转义，`\|` 会变回 `|`，
#      而 `||.+$` 在正则里等价于恒真，会让所有请求都被判给 objbox。
#
# 部署时把 <host> 换成自己的域名，证书路径按实际填。

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name s3.<host>;

    ssl_certificate     /etc/letsencrypt/live/s3.<host>/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/s3.<host>/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    # SigV4 的 CanonicalRequest 含 Host 头：反代必须原样透传 Host；大对象要关请求缓冲
    client_max_body_size 0;
    proxy_request_buffering off;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;

    # ── 管理面：经 auth-gateway（SSO BFF）。网关登录成功后注入 X-Auth-User，objbox 只认这个头 ──
    location /_auth/ {
        proxy_pass http://127.0.0.1:18920;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
    }

    location /api/admin/ {
        proxy_pass http://127.0.0.1:18920;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
    }

    location = / {
        # 带 SigV4 签名或预签名参数 → objbox 的 ListBuckets；否则视为人用浏览器 → 网关做 SSO
        if ($http_authorization ~* "AWS4-HMAC-SHA256") {
            proxy_pass http://127.0.0.1:18930;
        }
        if ($args ~ "X-Amz-Signature") {
            proxy_pass http://127.0.0.1:18930;
        }
        proxy_pass http://127.0.0.1:18920;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
    }

    # ── S3 协议（/<bucket>/<key>）、管理台静态资源、CORS 预检：直连 objbox，SigV4 完全不受影响 ──
    location / {
        proxy_pass http://127.0.0.1:18930;
    }
}

# 接入清单（照做即可）：
#  1. auth-gateway 的 config.yaml 里登记一个 app：
#       - id: objbox
#         hosts: [s3.<host>]
#         mode: protect
#         secret_file: /etc/auth-gateway/objbox.secret
#         routes:
#           - { prefix: /api/admin/, upstream: "http://127.0.0.1:18930", auth: required }
#           - { prefix: /,           upstream: "http://127.0.0.1:18930", auth: required }
#  2. objbox.secret 的内容必须与认证中心 clients.json 里 client_id=objbox 的 client_secret **完全一致**。
#  3. 认证中心 clients.json 增加：
#       { "client_id": "objbox", "client_secret": "<同上的值>",
#         "redirect_uris": ["https://s3.<host>/", "https://s3.<host>/_auth/callback"],
#         "post_logout_redirect_uris": ["https://s3.<host>/"],
#         "grant_types": ["authorization_code", "refresh_token"],
#         "scopes": ["openid", "profile", "offline_access"] }
#  4. objbox 侧加环境变量 AUTH_MODE=sso（systemd drop-in 即可），重启。
#  5. 验收：浏览器访问 / 应 302 到认证中心并最终进管理台；同时用真实 AK/SK 跑一次
#     ListBuckets / PutObject / GetObject，确认 S3 端点没被 SSO 拦住。
#
# 开源默认值：不带这段 nginx 也能用 —— AUTH_MODE 缺省为 builtin，管理台走自带口令。
